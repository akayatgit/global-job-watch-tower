# --- Secrets & local credentials (never commit) ---
.env
.env.*
!.env.example
.cursor/rules/password.mdc
**/credentials*.json
**/*secret*
**/*.pem
**/*.key
# Cloudflare Tunnel credentials (Option B remote access)
.cloudflared/
**/.cloudflared/

# --- Runtime / local data (Watch Tower pilot) ---
job_engine/.data/
**/.data/
**/pgdata/
**/redis/
*.pid
celerybeat-schedule
celerybeat-schedule.*

# Hermes daily brief output — regenerated by cron every run, never source.
# A tracked copy here previously left the ThinkPad's working tree "dirty"
# forever and silently wedged every deploy (see documents/deploy-verification.md).
documents/briefs/

# --- Logs & caches ---
*.log
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/
*.egg-info/
dist/
build/

# --- Frontend (VIGIL builds on deploy) ---
node_modules/
job_engine/vigil/node_modules/
job_engine/vigil/dist/

# --- Virtual envs / OS junk ---
.venv/
venv/
env/
.Python
.DS_Store
Thumbs.db
*.swp
*~

# --- Editor noise (keep shared Cursor project rules; ignore local junk) ---
.cursor/*.log
.idea/
.vscode/
*.code-workspace

# Large offline docker image backups
backups/
*.tar.gz
