# Local-only settings — no cloud services
DATABASE_URL=postgresql+psycopg2://jobengine:jobengine@127.0.0.1:5433/jobengine
REDIS_URL=redis://127.0.0.1:6379/0

# Scraping pilot defaults
SECTOR=software
MIN_DELAY_S=8
MAX_DELAY_S=22
MAX_PAGES=10
HEADLESS=true
FETCH_RETRIES=2
STALE_RUN_MINUTES=180
# ollama = quality path (default). keyword = Plan B ONLY (critical heat / no GPU).
# auto = legacy alias for ollama.
RELEVANCE_MODE=ollama
OLLAMA_BATCH_SIZE=10

# Seconds spent "acting human" on each results page before scraping it
PAGE_DWELL_MIN_S=75
PAGE_DWELL_MAX_S=105

# Chrome profiles
CHROME_SOURCE_PROFILE=/home/user/.config/google-chrome
CHROME_BOT_PROFILE=/home/user/.config/google-chrome-linkedin

# Local Ollama model for job-title relevance filtering
# Title filter only — qwen3.5:4b (do not use 9b/27b for this)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_THINK=false
OLLAMA_TIMEOUT_S=45

# Beat + thermal (see app/thermal.py) — longer Warm/Hot rests = stay on Ollama
BEAT_SCAN_INTERVAL_S=90
HEAT_COOL_MAX_C=65
HEAT_WARM_MAX_C=75
HEAT_HOT_MAX_C=85
HEAT_BREAK_COOL_S=12
HEAT_BREAK_WARM_S=55
HEAT_BREAK_HOT_S=120
HEAT_BREAK_CRITICAL_S=180
HEAT_PREEMPT_MARGIN_C=4
HEAT_COOLDOWN_RETRIES=3
HEAT_REQUIRE_GPU=true
OLLAMA_BATCH_SIZE=8

HEADLESS=true
RELEVANCE_MODE=ollama

# Replicate — carousel fire (Gate 1). Never commit the real token.
REPLICATE_API_TOKEN=
# Include :version hash — required by Replicate Python client
REPLICATE_MODEL=google/nano-banana-2:d1be8b5fc0931a253d417e12a484ac01ee9ccbc6daffd4792151377d5e5ff55f

# DIRECTOR (OpenAI Agents SDK) — never commit real keys
OPENAI_API_KEY=
OPENAI_BRAIN_MODEL=gpt-4.1-mini
DIRECTOR_SESSION_DB=

# JobMaster — LLM only ever translates language / adds tone; Watch Tower
# APIs + deterministic formatters own every fact. Both fall back to plain
# regex/templates automatically when OPENAI_API_KEY is empty.
JOBMASTER_LLM_INTENT=true
# 1A voice layer (2026-08-05): warmer natural phrasing around a deterministic
# reply, fact-locked — see app/telegram_voice.py.
JOBMASTER_VOICE_LLM=true
