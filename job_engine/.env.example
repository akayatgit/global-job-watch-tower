# Local-only settings — no cloud services
DATABASE_URL=postgresql+psycopg2://jobengine:jobengine@127.0.0.1:5433/jobengine
REDIS_URL=redis://127.0.0.1:6379/0

# Scraping pilot defaults
SECTOR=software
MIN_DELAY_S=8
MAX_DELAY_S=22
MAX_PAGES=10
HEADLESS=true
FETCH_RETRIES=2
STALE_RUN_MINUTES=180
# ollama = quality path (default). keyword = Plan B ONLY (critical heat / no GPU).
# auto = legacy alias for ollama.
RELEVANCE_MODE=ollama
OLLAMA_BATCH_SIZE=10

# Seconds spent "acting human" on each results page before scraping it
PAGE_DWELL_MIN_S=75
PAGE_DWELL_MAX_S=105

# Chrome profiles
CHROME_SOURCE_PROFILE=/home/user/.config/google-chrome
CHROME_BOT_PROFILE=/home/user/.config/google-chrome-linkedin

# Local Ollama model for job-title relevance filtering
# Title filter only — qwen3.5:4b (do not use 9b/27b for this)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_THINK=false
OLLAMA_TIMEOUT_S=45

# Beat + thermal (see app/thermal.py) — longer Warm/Hot rests = stay on Ollama
BEAT_SCAN_INTERVAL_S=90
HEAT_COOL_MAX_C=65
HEAT_WARM_MAX_C=75
HEAT_HOT_MAX_C=85
HEAT_BREAK_COOL_S=12
HEAT_BREAK_WARM_S=55
HEAT_BREAK_HOT_S=120
HEAT_BREAK_CRITICAL_S=180
HEAT_PREEMPT_MARGIN_C=4
HEAT_COOLDOWN_RETRIES=3
HEAT_REQUIRE_GPU=true
OLLAMA_BATCH_SIZE=8

HEADLESS=true
RELEVANCE_MODE=ollama

# Partner API — AvatarPitch (/api/partner/v1/). Bearer token shared with the
# partner app (Vercel) over the Cloudflare tunnel. Empty = partner API
# disabled (503). Never commit the real token.
PARTNER_API_TOKEN=
# Asset storage root for PUT/GET /api/partner/v1/assets/{key} (48h GC)
PARTNER_ASSETS_DIR=/srv/avatarpitch/uploads
PARTNER_PUBLIC_BASE_URL=https://tower.jobmaster.agency

# Replicate — carousel fire (Gate 1). Never commit the real token.
REPLICATE_API_TOKEN=
# Include :version hash — required by Replicate Python client
REPLICATE_MODEL=google/nano-banana-2:d1be8b5fc0931a253d417e12a484ac01ee9ccbc6daffd4792151377d5e5ff55f

# Prompt Tower (pivot 2026-09-09: "Jobs are now prompts") — see
# documents/prompt-tower.md. prompts = job beat asleep · jobs = legacy.
TOWER_MODE=prompts
PROMPT_PIPELINE_UTC_HOUR=3
PROMPT_PIPELINE_UTC_MINUTE=30
PROMPT_REDDIT_SUBS=aivideo,PromptEngineering,VeoAI,KlingAI,Sora,runwayml,AIVideoPrompts
# Seconds between subreddit fetches (Reddit 429s on bursts)
PROMPT_REDDIT_PAUSE_S=8
# Leave blank to use the built-in D2C ad-prompt handbook list (app/config.py)
PROMPT_WEB_URLS=
# Instagram hashtags (no #) via the logged-in stealth Chrome; empty = off
PROMPT_INSTAGRAM_TAGS=
PROMPT_SOURCE_LIMIT=40
PROMPT_SHORTLIST_SIZE=10
PROMPT_MIN_SCORE=55
# ollama pull nomic-embed-text
PROMPT_EMBED_MODEL=nomic-embed-text
# Replicate image→video model for approved prompts (kling / veo / seedance / minimax / wan)
REPLICATE_VIDEO_MODEL=kwaivgi/kling-v2.1
PROMPT_VIDEO_DURATION_S=10
PROMPT_ASSET_PREFIX=prompts
# Reverse prompt (/igtovid · /pintovid): Gemini watches the downloaded clip
REPLICATE_VISION_MODEL=google/gemini-2.5-flash
# Empty = bundled LV Pacific Chill exemplar (app/prompts/reverse_exemplar.txt)
PROMPT_REVERSE_EXEMPLAR_PATH=
PROMPT_REVERSE_MAX_VIDEO_MB=80
# Magic-pencil stills (text+image→image). Nano Banana 2 Lite + a one-line
# "Change from x to y, and z". Lite is 1K. For 2K/4K set google/nano-banana-2.
PROMPT_TWIST_IMAGE_MODEL=google/nano-banana-2-lite
# After twisted stills: Gemini Omni motion transfer (original clip + stills).
PROMPT_TWIST_VIDEO_MODEL=google/gemini-omni-1.1
# Reverse model buttons after the title. All three get the video file.
# Gemini watches it natively (Replicate). Astra / Fable get the mp4
# (native video block if the API accepts it, otherwise the file in their
# code sandbox — same as handing the clip to Astra in Codex).
PROMPT_REVERSE_ASTRA_MODEL=gpt-6-astra
PROMPT_REVERSE_FABLE_MODEL=claude-fable-5

# DIRECTOR (OpenAI Agents SDK) — never commit real keys
OPENAI_API_KEY=
OPENAI_BRAIN_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
DIRECTOR_SESSION_DB=

# JobMaster — LLM only ever translates language / adds tone; Watch Tower
# APIs + deterministic formatters own every fact. Both fall back to plain
# regex/templates automatically when OPENAI_API_KEY is empty.
JOBMASTER_LLM_INTENT=true
# 1A voice layer (2026-08-05): warmer natural phrasing around a deterministic
# reply, fact-locked — see app/telegram_voice.py.
JOBMASTER_VOICE_LLM=true
