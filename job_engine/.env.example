# Local-only settings — no cloud services
DATABASE_URL=postgresql+psycopg2://jobengine:jobengine@127.0.0.1:5433/jobengine
REDIS_URL=redis://127.0.0.1:6379/0

# Scraping pilot defaults
SECTOR=software
MIN_DELAY_S=8
MAX_DELAY_S=22
MAX_PAGES=10
HEADLESS=true
FETCH_RETRIES=2
STALE_RUN_MINUTES=180
# keyword = cool (no Ollama). ollama = quality when NVIDIA driver works.
RELEVANCE_MODE=keyword

# Seconds spent "acting human" on each results page before scraping it
PAGE_DWELL_MIN_S=75
PAGE_DWELL_MAX_S=105

# Chrome profiles
CHROME_SOURCE_PROFILE=/home/user/.config/google-chrome
CHROME_BOT_PROFILE=/home/user/.config/google-chrome-linkedin

# Local Ollama model for job-title relevance filtering
OLLAMA_MODEL=qwen3.5:9b
# Keep false for reliable throughput (thinking mode can take minutes/batch)
OLLAMA_THINK=false
OLLAMA_TIMEOUT_S=90

# Beat scan interval (seconds)
BEAT_SCAN_INTERVAL_S=60

HEADLESS=true
RELEVANCE_MODE=keyword
